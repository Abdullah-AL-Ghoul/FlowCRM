# ==============================================================================
# FlowCRM — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the project root: `cp .env.example .env`
# 2. Fill in your Supabase project URL and anon/publishable public key.
# 3. Note: If these variables are not provided or remain empty, FlowCRM runs in
#    Isolated Demo Mode with realistic local data so that all features can be
#    evaluated immediately.
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (SAFE for client-side use)
# DO NOT EVER PLACE YOUR SERVICE_ROLE KEY HERE!
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional Application Base URL
VITE_APP_URL=http://localhost:5173
